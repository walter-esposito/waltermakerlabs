---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  articolo: CollectionEntry<'articoli'>;
}
const { articolo } = Astro.props;
const d = articolo.data;
const href = `/${d.categoria}/${articolo.id}/`;
---

<li class="scheda">
  <a href={href} tabindex="-1" aria-hidden="true">
    <Image src={d.cover} alt="" widths={[320, 640]} sizes="(max-width: 48rem) 100vw, 17rem" loading="lazy" />
  </a>
  <div class="scheda__corpo">
    <span class="etichetta">{d.tipo}</span>
    <h3><a href={href}>{d.title}</a></h3>
    <p>{d.description}</p>
  </div>
</li>
