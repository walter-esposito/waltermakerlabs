---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import { u } from '../lib/url';
import {
  type Lingua,
  T,
  ETICHETTA_CATEGORIA,
  ETICHETTA_TIPO,
  percorsoCategoria,
  percorsoHome,
} from '../lib/i18n';

interface Props {
  articolo: CollectionEntry<'articoli'> | CollectionEntry<'articoliEn'>;
  lingua?: Lingua;
  /** Percorso della stessa pagina nell'altra lingua, se la traduzione esiste. */
  alternato?: string;
}

const { articolo, lingua = 'it', alternato } = Astro.props;
const d = articolo.data;
const t = T[lingua];

const etichettaCat = ETICHETTA_CATEGORIA[lingua][d.categoria];
const urlPagina = new URL(Astro.url.pathname, Astro.site).href;
const urlCover = new URL(d.cover.src, Astro.site).href;
const urlHome = new URL(u(percorsoHome(lingua)), Astro.site).href;
const urlCategoria = new URL(u(percorsoCategoria(lingua, d.categoria)), Astro.site).href;

const fmt = (x: Date) =>
  new Intl.DateTimeFormat(lingua === 'it' ? 'it-IT' : 'en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(x);

/* ---- dati strutturati ---------------------------------------------------- */

const autore = {
  '@type': 'Person',
  name: 'Walter Esposito',
  url: 'https://www.youtube.com/@waltermakerlabs',
};

const schemaArticolo = {
  // Review richiede itemReviewed + reviewRating: senza i dati del prodotto sarebbe
  // uno schema invalido, quindi resta BlogPosting finche' non vengono compilati.
  '@type': d.tipo === 'recensione' && d.prodotto ? 'Review' : 'BlogPosting',
  '@id': `${urlPagina}#articolo`,
  headline: d.title,
  description: d.description,
  image: urlCover,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: autore,
  publisher: {
    '@type': 'Organization',
    name: 'Walter Maker Labs',
    url: urlHome,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': urlPagina },
  inLanguage: 'it-IT',
  ...(d.tipo === 'recensione' && d.prodotto
    ? {
        itemReviewed: {
          '@type': 'Product',
          name: d.prodotto.nome,
          brand: { '@type': 'Brand', name: d.prodotto.marca },
          ...(d.prodotto.prezzoIndicativo
            ? {
                offers: {
                  '@type': 'Offer',
                  price: d.prodotto.prezzoIndicativo,
                  priceCurrency: 'EUR',
                },
              }
            : {}),
        },
        reviewRating: {
          '@type': 'Rating',
          ratingValue: d.prodotto.voto,
          bestRating: 5,
          worstRating: 1,
        },
      }
    : {}),
};

const schemaVideo = d.videoId
  ? {
      '@type': 'VideoObject',
      '@id': `${urlPagina}#video`,
      name: d.title,
      description: d.description,
      thumbnailUrl: `https://i.ytimg.com/vi/${d.videoId}/maxresdefault.jpg`,
      uploadDate: d.pubDate.toISOString(),
      ...(d.videoDurata ? { duration: d.videoDurata } : {}),
      embedUrl: `https://www.youtube-nocookie.com/embed/${d.videoId}`,
      contentUrl: `https://www.youtube.com/watch?v=${d.videoId}`,
      publisher: { '@type': 'Organization', name: 'Walter Maker Labs' },
    }
  : null;

const schemaBriciole = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.home, item: urlHome },
    {
      '@type': 'ListItem',
      position: 2,
      name: etichettaCat,
      item: urlCategoria,
    },
    { '@type': 'ListItem', position: 3, name: d.title, item: urlPagina },
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [schemaArticolo, schemaBriciole, ...(schemaVideo ? [schemaVideo] : [])],
};

const { Content } = await render(articolo);
---

<BaseLayout
  title={`${d.title} | Walter Maker Labs`}
  description={d.description}
  ogImage={d.cover.src}
  tipoOg="article"
  lingua={lingua}
  alternato={alternato}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <nav class="briciole" aria-label={t.percorso}>
    <ol>
      <li><a href={u(percorsoHome(lingua))}>{t.home}</a></li>
      <li><a href={u(percorsoCategoria(lingua, d.categoria))}>{etichettaCat}</a></li>
      <li aria-current="page">{d.title}</li>
    </ol>
  </nav>

  <article class="articolo">
    <span class="etichetta">{ETICHETTA_TIPO[lingua][d.tipo]}</span>
    <h1>{d.title}</h1>

    <p class="articolo__meta">
      <time datetime={d.pubDate.toISOString()}>{fmt(d.pubDate)}</time>
      {d.updatedDate && <> · {t.aggiornatoIl} <time datetime={d.updatedDate.toISOString()}>{fmt(d.updatedDate)}</time></>}
    </p>

    <p class="articolo__sommario">{d.description}</p>

    {
      d.videoId ? (
        <YouTubeEmbed id={d.videoId} titolo={d.title} lazy={false} />
      ) : (
        <Image src={d.cover} alt={d.coverAlt} widths={[480, 800, 1200]} loading="eager" />
      )
    }

    <Content />

    {
      d.shorts && d.shorts.length > 0 && (
        <section class="episodi">
          <h2>{d.tipo === "risoluzione-problemi" ? t.videoInOrdine : t.episodiInOrdine}</h2>
          <ol class="episodi__lista">
            {d.shorts.map((s) => (
              <li>
                <YouTubeEmbed id={s.id} titolo={s.titolo} verticale={!s.orizzontale} />
                <h3>{s.titolo}</h3>
                {s.nota && <p>{s.nota}</p>}
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </article>
</BaseLayout>
