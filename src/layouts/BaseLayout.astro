---
import '../styles/global.css';
import { CATEGORIE } from '../content.config';
import { u, ANTEPRIMA } from '../lib/url';
import { getCollection } from 'astro:content';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  /** Immagine per le anteprime social. Percorso assoluto dalla root del sito. */
  ogImage?: string;
  /** Mettilo a true sulle pagine di filtro che non devono entrare in indice. */
  noindex?: boolean;
  tipoOg?: 'website' | 'article';
}

const { title, description, ogImage = '/og-default.jpg', noindex = false, tipoOg = 'website' } =
  Astro.props;

// Una sezione senza articoli e' una pagina vuota: fuori dal menu finche' non si riempie.
const pubblicati = await getCollection('articoli', ({ data }) => !data.draft);
const categoriePiene = new Set(pubblicati.map((a) => a.data.categoria));
const tipiPieni = new Set(pubblicati.map((a) => a.data.tipo));

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogAssoluta = new URL(ogImage, Astro.site).href;

const ETICHETTE: Record<string, string> = {
  'stampa-3d': 'Stampa 3D',
  cnc: 'CNC',
  laser: 'Laser',
  ai: 'AI',
  canale: 'Il canale',
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || ANTEPRIMA) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={tipoOg} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAssoluta} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Walter Maker Labs" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={u("/favicon-32.png")} sizes="32x32" />
    <link rel="apple-touch-icon" href={u("/apple-touch-icon.png")} />
    <link rel="sitemap" href={u("/sitemap-index.xml")} />
    <link rel="alternate" type="application/rss+xml" title="Walter Maker Labs" href={u("/rss.xml")} />

    <meta name="generator" content={Astro.generator} />
    <Analytics />
    <slot name="head" />
  </head>

  <body>
    <a class="salta-al-contenuto" href="#contenuto">Salta al contenuto</a>

    <header class="sito-header">
      <div class="contenitore">
        <a class="marchio" href={u("/")} aria-label="Walter Maker Labs, vai alla home">
          {/* La barra e' sempre scura, quindi serve solo la variante crema. */}
          <img
            src={u("/logo-chiaro.png")}
            alt="Walter Maker Labs"
            width="577"
            height="445"
            decoding="async"
          />
        </a>
        <nav class="sito-nav" aria-label="Principale">
          {
            CATEGORIE.filter((c) => categoriePiene.has(c)).map((c) => (
              <a href={u(`/${c}/`)} aria-current={Astro.url.pathname.startsWith(`/${c}/`) ? 'page' : undefined}>
                {ETICHETTE[c]}
              </a>
            ))
          }
          {tipiPieni.has("recensione") && <a href={u("/recensioni/")}>Recensioni</a>}
          {tipiPieni.has("risoluzione-problemi") && <a href={u("/risoluzione-problemi/")}>Problemi</a>}
          <a href="https://www.youtube.com/@waltermakerlabs" rel="me">YouTube</a>
        </nav>
      </div>
    </header>

    <main id="contenuto" class="contenitore">
      <slot />
    </main>

    <footer class="sito-footer">
      <div class="contenitore">
        <p>
          <strong>Walter Maker Labs</strong> — stampa 3D, CNC, laser e AI applicata al making.
          I video sul canale <a href="https://www.youtube.com/@waltermakerlabs">@waltermakerlabs</a>.
        </p>
        <p>
          Cerchi elettronica e Arduino? Sono su
          <a href="https://arduinoproject.it/">ArduinoProject.it</a>.
        </p>
        <p>
          © {new Date().getFullYear()} Walter Esposito &middot;
          <a href={u("/privacy/")}>Privacy e cookie</a>
        </p>
      </div>
    </footer>
  </body>
</html>
