---
import '../styles/global.css';
import { CATEGORIE } from '../content.config';
import { u, ANTEPRIMA } from '../lib/url';
import { getCollection } from 'astro:content';
import Analytics from '../components/Analytics.astro';
import { GOOGLE, BING } from '../config/verifiche';

import {
  type Lingua,
  T,
  ETICHETTA_CATEGORIA,
  percorsoCategoria,
  percorsoHome,
} from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  /** Immagine per le anteprime social. Percorso assoluto dalla root del sito. */
  ogImage?: string;
  /** Mettilo a true sulle pagine di filtro che non devono entrare in indice. */
  noindex?: boolean;
  tipoOg?: 'website' | 'article';
  lingua?: Lingua;
  /** Percorso della stessa pagina nell'altra lingua, se la traduzione esiste. */
  alternato?: string;
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  noindex = false,
  tipoOg = 'website',
  lingua = 'it',
  alternato,
} = Astro.props;

const t = T[lingua];
const ETICHETTE = ETICHETTA_CATEGORIA[lingua];

// Una sezione senza articoli e' una pagina vuota: fuori dal menu finche' non si riempie.
const pubblicati = await getCollection(lingua === 'it' ? 'articoli' : 'articoliEn', ({ data }) => !data.draft);
const categoriePiene = new Set(pubblicati.map((a) => a.data.categoria));
const tipiPieni = new Set(pubblicati.map((a) => a.data.tipo));

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogAssoluta = new URL(ogImage, Astro.site).href;

/**
 * hreflang nei due sensi. Senza, Google leggerebbe originale e traduzione come
 * due pagine che si fanno concorrenza invece che come due versioni della stessa.
 * x-default punta all'italiano: e' la lingua da cui nasce il sito.
 */
const urlAlternato = alternato ? new URL(u(alternato), Astro.site).href : undefined;
const urlIt = lingua === 'it' ? canonical : urlAlternato;
const urlEn = lingua === 'en' ? canonical : urlAlternato;
---

<!doctype html>
<html lang={lingua}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || ANTEPRIMA) && <meta name="robots" content="noindex, nofollow" />}

    {urlIt && urlEn && (
      <>
        <link rel="alternate" hreflang="it" href={urlIt} />
        <link rel="alternate" hreflang="en" href={urlEn} />
        <link rel="alternate" hreflang="x-default" href={urlIt} />
      </>
    )}

    <meta property="og:type" content={tipoOg} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAssoluta} />
    <meta property="og:locale" content={lingua === 'it' ? 'it_IT' : 'en_US'} />
    <meta property="og:site_name" content="Walter Maker Labs" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={u("/favicon-32.png")} sizes="32x32" />
    <link rel="apple-touch-icon" href={u("/apple-touch-icon.png")} />
    <link rel="sitemap" href={u("/sitemap-index.xml")} />
    <link rel="alternate" type="application/rss+xml" title="Walter Maker Labs" href={u("/rss.xml")} />

    <meta name="generator" content={Astro.generator} />
    {GOOGLE && <meta name="google-site-verification" content={GOOGLE} />}
    {BING && <meta name="msvalidate.01" content={BING} />}

    <Analytics />
    <slot name="head" />
  </head>

  <body>
    <a class="salta-al-contenuto" href="#contenuto">{t.saltaAlContenuto}</a>

    <header class="sito-header">
      <div class="contenitore">
        <a class="marchio" href={u(percorsoHome(lingua))} aria-label={t.vaiAllaHome}>
          {/* La barra e' sempre scura, quindi serve solo la variante crema. */}
          <img
            src={u("/logo-chiaro.png")}
            alt="Walter Maker Labs"
            width="577"
            height="445"
            decoding="async"
          />
        </a>
        <nav class="sito-nav" aria-label={t.navPrincipale}>
          {
            CATEGORIE.filter((c) => categoriePiene.has(c)).map((c) => (
              <a
                href={u(percorsoCategoria(lingua, c))}
                aria-current={Astro.url.pathname.startsWith(u(percorsoCategoria(lingua, c))) ? 'page' : undefined}
              >
                {ETICHETTE[c]}
              </a>
            ))
          }
          {lingua === 'it' && tipiPieni.has("recensione") && <a href={u("/recensioni/")}>{t.recensioni}</a>}
          {lingua === 'it' && tipiPieni.has("risoluzione-problemi") && <a href={u("/risoluzione-problemi/")}>{t.problemi}</a>}
          <a href="https://www.youtube.com/@waltermakerlabs" rel="me">YouTube</a>
          {
            alternato && (
              <a class="cambia-lingua" href={u(alternato)} hreflang={lingua === 'it' ? 'en' : 'it'} title={t.altraLinguaTitolo}>
                {t.altraLingua}
              </a>
            )
          }
        </nav>
      </div>
    </header>

    <main id="contenuto" class="contenitore">
      <slot />
    </main>

    <footer class="sito-footer">
      <div class="contenitore">
        <p>
          <strong>Walter Maker Labs</strong> — {t.footerClaim}
          {' '}{t.footerVideo} <a href="https://www.youtube.com/@waltermakerlabs">@waltermakerlabs</a>.
        </p>
        <p>
          {t.footerArduino}
          <a href="https://arduinoproject.it/">ArduinoProject.it</a>.
        </p>
        <p>
          © {new Date().getFullYear()} Walter Esposito &middot;
          <a href={u("/sconti/")}>{t.footerSconti}</a> &middot;
          <a href={u("/privacy/")}>{t.footerPrivacy}</a>
        </p>
      </div>
    </footer>
  </body>
</html>
