---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SchedaArticolo from '../components/SchedaArticolo.astro';

const articoli = (await getCollection('articoli', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Walter Maker Labs — stampa 3D, CNC, laser e AI per maker"
  description="Prove sul campo, recensioni e guide su stampanti 3D, CNC, incisori laser e AI applicata al making. Ogni articolo con il video del canale @waltermakerlabs."
>
  <section style="padding-block: 3rem 1rem; max-width: 46rem;">
    <h1>Prove vere, in officina.</h1>
    <p style="font-size: 1.15rem; color: var(--testo-tenue);">
      Stampa 3D, CNC, laser e AI applicata al making. Niente schede copiate dai comunicati stampa:
      misure, errori e risultati reali, con il video di ogni prova.
    </p>
  </section>

  {
    articoli.length === 0 ? (
      <p style="color: var(--testo-tenue);">I primi articoli stanno arrivando.</p>
    ) : (
      <>
        <h2>Ultimi articoli</h2>
        <ul class="griglia">
          {articoli.map((a) => (
            <SchedaArticolo articolo={a} />
          ))}
        </ul>
      </>
    )
  }
</BaseLayout>
